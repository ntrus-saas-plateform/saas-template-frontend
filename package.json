    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "iron-session": "^9.0.1",
    "jose": "^6.2.10",
    "keycloak-js": "^26.2.4",
    "lucide-react": "^1.40.0",
    "motion": "^13.2.0",
