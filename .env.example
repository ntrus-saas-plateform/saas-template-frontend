NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Auth: bff (HttpOnly session — recommended) | spa (keycloak-js Wave 0)
NEXT_PUBLIC_AUTH_MODE=bff

# Shared Keycloak settings (public) — must match realm client `platform-web`
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8181
NEXT_PUBLIC_KEYCLOAK_REALM=platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=platform-web

# Web Push (must match server VAPID_PUBLIC_KEY when PUSH_DELIVERY_ENABLED=true)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# BFF server-side (preferred). Falls back to NEXT_PUBLIC_* when unset.
KEYCLOAK_URL=http://localhost:8181
KEYCLOAK_REALM=platform
KEYCLOAK_CLIENT_ID=platform-web
# Public PKCE client — leave secret empty
# KEYCLOAK_CLIENT_SECRET=
API_BASE_URL=http://localhost:3000
# Min 32 chars — required for iron-session in production
SESSION_SECRET=dev_only_change_me_to_a_long_random_secret_32chars

# ---------------------------------------------------------------------------
# Okapi Edge Admin Console (isolated from ERP BFF / platform realm)
# Cookies: okapi_edge_bff_session + okapi_edge_csrf
# Routes: /api/edge-auth/* · /api/edge-backend/* · /api/edge-bootstrap · /edge/*
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EDGE_KEYCLOAK_URL=http://localhost:8181
NEXT_PUBLIC_EDGE_KEYCLOAK_REALM=edge-admin
NEXT_PUBLIC_EDGE_KEYCLOAK_CLIENT_ID=edge-admin-web

EDGE_KEYCLOAK_URL=http://localhost:8181
EDGE_KEYCLOAK_REALM=edge-admin
EDGE_KEYCLOAK_CLIENT_ID=edge-admin-web
# Public PKCE client — leave secret empty
# EDGE_KEYCLOAK_CLIENT_SECRET=

# Dedicated iron-session password for Edge (required in production, ≥32 chars).
# In development, if unset, a distinct secret is derived from SESSION_SECRET.
SESSION_SECRET_EDGE=dev_only_edge_change_me_to_a_long_random_secret_32
