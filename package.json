    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.58.2",
